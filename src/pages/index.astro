---
import Layout from '../layouts/Layout.astro';
import BatteryHero from '../components/BatteryHero.astro';
import { posts, fmtDate, postHref } from '../data/posts';
---

<Layout title="Cooper Minehart">
  <section class="relative bg-[#0b1a12] overflow-hidden">
    <!-- Battery art: decorative background -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none"
         style="opacity: 0.22; transform: scale(1.8); transform-origin: center;">
      <BatteryHero />
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 py-14 md:py-16">
      <div class="grid md:grid-cols-[1fr_360px] gap-10 md:gap-14 items-start">

        <!-- Intro -->
        <div class="md:pt-6">
          <img
            src="/photos/headshot.jpeg"
            alt="Cooper Minehart"
            class="w-28 h-28 rounded-full object-cover object-top ring-2 ring-forest-400/30 mb-6"
          />
          <p class="text-xs font-semibold tracking-widest uppercase text-forest-300 mb-3">
            PhD Student · Engineering &amp; Public Policy · Carnegie Mellon
          </p>
          <h1 class="font-serif text-4xl sm:text-5xl font-bold text-white leading-tight mb-5">
            Cooper Minehart
          </h1>
          <p class="text-lg text-stone-100 leading-relaxed max-w-xl">
            I work in the Whitefoot Lab at Carnegie Mellon to understand engineering, policy,
            and economic aspects of transportation electrification. I taught statics in MechE
            at Cal Poly and ran the propulsion team for an eVTOL test campaign.
          </p>
        </div>

        <!-- Sidebar: blog posts -->
        <aside class="bg-[#FAFAF8]/95 rounded-lg p-5 shadow-lg">
          <div class="flex items-baseline justify-between mb-4">
            <h2 class="text-xs font-semibold tracking-widest uppercase text-forest-700">Blog</h2>
            <a href="/blog" class="text-xs text-forest-600 hover:underline">All posts →</a>
          </div>
          <ul class="divide-y divide-stone-200">
            {posts.slice(0, 6).map((post) => { const { title, photo, alt, date } = post; return (
              <li>
                <a href={postHref(post)} target={post.url ? '_blank' : undefined} rel={post.url ? 'noopener' : undefined} class="group flex gap-3 py-3 items-center">
                  <img src={photo} alt={alt} loading="lazy"
                       class="w-14 h-14 flex-none rounded object-cover border border-stone-200" />
                  <div class="min-w-0">
                    <p class="text-[11px] font-mono text-[#888]">{fmtDate(date)}</p>
                    <p class="font-serif text-[15px] leading-snug text-[#1a1a1a] group-hover:text-forest-600 transition-colors">
                      {title}
                    </p>
                  </div>
                </a>
              </li>
            ); })}
          </ul>
        </aside>
      </div>

      <!-- CAISO caption -->
      <a id="battery-caption" href="https://www.caiso.com/todays-outlook" target="_blank" rel="noopener" class="mt-10 font-mono text-xs text-forest-400/80 text-center hover:text-forest-300 transition-colors block"></a>
    </div>
  </section>
</Layout>
